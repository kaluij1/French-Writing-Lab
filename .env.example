# ─── Claude (writing analysis) ────────────────────────────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_.
# Leave empty to run with the built-in demo analyzer (spends nothing).
ANTHROPIC_API_KEY=
# Optional model override for every lens. Default: claude-haiku-5-5 (lowest cost).
# ANTHROPIC_MODEL=claude-haiku-5-5
# Optional per-lens overrides (take precedence), e.g. a stronger model for Complexity only:
# ANTHROPIC_MODEL_GRAMMAR=
# ANTHROPIC_MODEL_VOCABULARY=
# ANTHROPIC_MODEL_MIXING=
# ANTHROPIC_MODEL_COMPLEXITY=claude-sonnet-5-5

# ─── Access protection ────────────────────────────────────────────────────────
# Required in production when ANTHROPIC_API_KEY is set and Supabase is not configured:
# without it, /api/analyze refuses to run (fails closed). Use a long random passphrase.
# Changing it signs everyone out.
APP_ACCESS_PASSWORD=
# Per-person analysis limits (per server instance). Defaults: 6 per minute, 40 per hour.
# ANALYSIS_LIMIT_PER_MINUTE=6
# ANALYSIS_LIMIT_PER_HOUR=40

# ─── Supabase (accounts + database) ───────────────────────────────────────────
# Leave both empty to run without accounts (data stays in the browser).
# When set, Supabase sign-in replaces the access password. The anon key is safe to
# expose: Row Level Security protects every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
