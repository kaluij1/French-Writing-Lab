# ─── Claude (writing analysis) ────────────────────────────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_.
# Leave empty to run with the built-in demo analyzer.
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-haiku-5-5 (lowest cost).
# For deeper feedback: claude-sonnet-5-5 (~20x Haiku) or claude-opus-5-5 (~40x Haiku).
# ANTHROPIC_MODEL=claude-haiku-5-5

# ─── Supabase (accounts + database) ───────────────────────────────────────────
# Leave both empty to run in demo mode (no sign-in, data stays in the browser).
# The anon key is safe to expose: Row Level Security protects every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
